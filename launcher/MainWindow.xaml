<Window x:Class="Fifawc10Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2010 FIFA World Cup South Africa: Recompiled"
        Width="780" Height="610" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        FontFamily="Segoe UI" FontSize="14">
  <Grid Margin="32,26,32,24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="2010 FIFA World Cup South Africa" FontSize="26" FontWeight="SemiBold"/>
      <TextBlock Text="Recompiled - native PC port" Foreground="{StaticResource Accent}" FontSize="15" Margin="0,2,0,0"/>
    </StackPanel>

    <!-- Game copy -->
    <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16" Margin="0,22,0,0">
      <StackPanel>
        <TextBlock Text="YOUR GAME" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold"/>
        <Grid Margin="0,8,0,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock x:Name="GamePathText" Text="No game selected" TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" FontSize="13"/>
          <Button Grid.Column="1" Content="Disc image (.iso)" Margin="12,0,0,0" Click="BrowseIso_Click"/>
          <Button Grid.Column="2" Content="Folder" Margin="8,0,0,0" Click="BrowseFolder_Click"/>
        </Grid>
        <TextBlock x:Name="StatusText" Margin="0,10,0,0" FontSize="13" TextWrapping="Wrap"
                   Foreground="{StaticResource Muted}" Text="Choose your Xbox 360 copy of the game."/>
      </StackPanel>
    </Border>

    <!-- Settings -->
    <Border Grid.Row="2" Background="{StaticResource Panel}" CornerRadius="10" Padding="20,16" Margin="0,14,0,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="SETTINGS" Style="{StaticResource Label}" FontSize="11" FontWeight="SemiBold"/>

        <TextBlock Grid.Row="1" Text="Display" Style="{StaticResource Label}" Margin="0,12,16,0"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="DisplayBox" HorizontalAlignment="Left" Margin="0,12,0,0">
          <ComboBoxItem Content="Window" Tag="Window"/>
          <ComboBoxItem Content="Borderless fullscreen" Tag="Borderless"/>
          <ComboBoxItem Content="Exclusive fullscreen" Tag="Fullscreen"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Text="Window size" Style="{StaticResource Label}" Margin="0,10,16,0"/>
        <ComboBox Grid.Row="2" Grid.Column="1" x:Name="WindowBox" HorizontalAlignment="Left" Margin="0,10,0,0">
          <ComboBoxItem Content="1280 x 720" Tag="1280x720"/>
          <ComboBoxItem Content="1600 x 900" Tag="1600x900"/>
          <ComboBoxItem Content="1920 x 1080" Tag="1920x1080"/>
          <ComboBoxItem Content="2560 x 1440" Tag="2560x1440"/>
          <ComboBoxItem Content="3840 x 2160" Tag="3840x2160"/>
        </ComboBox>

        <TextBlock Grid.Row="3" Text="Render resolution" Style="{StaticResource Label}" Margin="0,10,16,0"/>
        <ComboBox Grid.Row="3" Grid.Column="1" x:Name="ScaleBox" HorizontalAlignment="Left" Margin="0,10,0,0">
          <ComboBoxItem Content="720p (original)" Tag="1"/>
          <ComboBoxItem Content="1440p (2x)" Tag="2"/>
          <ComboBoxItem Content="4K (3x)" Tag="3"/>
        </ComboBox>

        <TextBlock Grid.Row="4" Text="Texture filtering" Style="{StaticResource Label}" Margin="0,10,16,0"/>
        <ComboBox Grid.Row="4" Grid.Column="1" x:Name="AnisoBox" HorizontalAlignment="Left" Margin="0,10,0,0">
          <ComboBoxItem Content="Original" Tag="-1"/>
          <ComboBoxItem Content="Anisotropic 4x" Tag="3"/>
          <ComboBoxItem Content="Anisotropic 8x" Tag="4"/>
          <ComboBoxItem Content="Anisotropic 16x" Tag="5"/>
        </ComboBox>

        <TextBlock Grid.Row="5" Text="Controls" Style="{StaticResource Label}" Margin="0,10,16,0"/>
        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,10,0,0">
          <ComboBox x:Name="ControlsBox">
            <ComboBoxItem Content="Controller" Tag="Controller"/>
            <ComboBoxItem Content="Keyboard" Tag="Keyboard"/>
          </ComboBox>
          <CheckBox x:Name="VSyncBox" Content="V-Sync" Margin="24,0,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Footer -->
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12"/>
        <TextBlock Foreground="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0">
          <Hyperlink x:Name="FolderLink" Click="OpenDataFolder_Click" Foreground="{StaticResource Muted}">Saves and logs folder</Hyperlink>
        </TextBlock>
      </StackPanel>
      <Button x:Name="PlayButton" Content="PLAY" Style="{StaticResource Play}" HorizontalAlignment="Right"
              Click="Play_Click" IsEnabled="False" IsDefault="True"/>
    </Grid>
  </Grid>
</Window>
