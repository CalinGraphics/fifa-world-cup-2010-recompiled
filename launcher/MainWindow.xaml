<Window x:Class="Fifawc10Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="2010 FIFA World Cup South Africa: Recompiled"
        Width="1180" Height="720" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Text}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

  <Border Margin="14" CornerRadius="10" Background="{StaticResource Night}">
    <Border.Effect>
      <DropShadowEffect BlurRadius="26" ShadowDepth="0" Opacity="0.6" Color="Black"/>
    </Border.Effect>
    <Grid x:Name="Root">
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#04060A" Offset="0"/>
          <GradientStop Color="#0A1016" Offset="0.42"/>
          <GradientStop Color="#090B0B" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>

      <!-- Stadium at night: drawn in code (MainWindow.Stadium.cs) -->
      <Canvas x:Name="Stadium" IsHitTestVisible="False"/>
      <Canvas x:Name="Confetti" IsHitTestVisible="False"/>

      <!-- legibility: dark floor under the title -->
      <Rectangle IsHitTestVisible="False">
        <Rectangle.Fill>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00000000" Offset="0.45"/>
            <GradientStop Color="#C0050607" Offset="0.86"/>
            <GradientStop Color="#F0050607" Offset="1"/>
          </LinearGradientBrush>
        </Rectangle.Fill>
      </Rectangle>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="560"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT: stage ===================== -->
        <Grid Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
          <StackPanel Orientation="Horizontal" Margin="34,26,0,0" VerticalAlignment="Top" HorizontalAlignment="Left">
            <Border Background="{StaticResource GoldMetal}" Padding="9,2,9,1" VerticalAlignment="Center">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
              <TextBlock Text="WC10" FontFamily="{StaticResource DisplayBold}" FontSize="15" Foreground="#17110A"/>
            </Border>
            <TextBlock Text="RECOMPILED" FontFamily="{StaticResource Caps}" FontSize="13" Foreground="#C9C8BF"
                       VerticalAlignment="Center" Margin="12,1,0,0"/>
          </StackPanel>

          <StackPanel VerticalAlignment="Bottom" Margin="34,0,20,40">
            <TextBlock Text="2010 FIFA WORLD CUP" Style="{StaticResource Label}" FontSize="15"/>
            <TextBlock Text="SOUTH" FontFamily="{StaticResource DisplayBold}" FontSize="104" Foreground="White"
                       Margin="-3,-6,0,-34"/>
            <TextBlock Text="AFRICA" FontFamily="{StaticResource DisplayBold}" FontSize="104" Foreground="White"
                       Margin="-3,0,0,-14"/>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
              <Rectangle Width="26" Height="4" Fill="{StaticResource Green}"/>
              <Rectangle Width="26" Height="4" Fill="{StaticResource Gold}"/>
              <Rectangle Width="26" Height="4" Fill="{StaticResource Red}"/>
              <TextBlock x:Name="TagLine" Text="Native PC port" FontFamily="{StaticResource Caps}" FontSize="13"
                         Foreground="#B9BAB3" Margin="14,-7,0,0"/>
            </StackPanel>
          </StackPanel>
        </Grid>

        <!-- ===================== RIGHT: broadcast panel ===================== -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Gold}" BorderThickness="0,3,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- nav + window buttons -->
            <Grid Background="Transparent" MouseLeftButtonDown="Drag_MouseDown">
              <StackPanel Orientation="Horizontal" Margin="40,18,0,0" VerticalAlignment="Bottom">
                <RadioButton x:Name="TabPlay" Content="PLAY" GroupName="nav" Style="{StaticResource NavTab}" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabDisplay" Content="DISPLAY" GroupName="nav" Style="{StaticResource NavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabGraphics" Content="GRAPHICS" GroupName="nav" Style="{StaticResource NavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabControls" Content="CONTROLS" GroupName="nav" Style="{StaticResource NavTab}" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabAbout" Content="ABOUT" GroupName="nav" Style="{StaticResource NavTab}" Checked="Tab_Checked"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize"/>
                <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click" ToolTip="Close"/>
              </StackPanel>
            </Grid>
            <Rectangle Height="1" Fill="{StaticResource Hair}" VerticalAlignment="Bottom" Margin="40,0,40,0"/>

            <Grid Grid.Row="1" Margin="40,30,40,0">

              <!-- PLAY -->
              <StackPanel x:Name="PagePlay">
                <TextBlock Text="YOUR COPY" Style="{StaticResource Label}"/>
                <Grid Margin="0,6,0,0">
                  <StackPanel Margin="0,0,130,0">
                    <TextBlock x:Name="StatusTitle" Text="No game selected" Style="{StaticResource Title}"/>
                    <TextBlock x:Name="StatusText" Text="Choose your Xbox 360 disc image, or drop it on this window."
                               Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0"/>
                  </StackPanel>
                  <!-- the check result, stamped on like a match ticket -->
                  <Border x:Name="Stamp" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                          BorderThickness="2.5" BorderBrush="{StaticResource Green}" Padding="12,3,12,2"
                          RenderTransformOrigin="0.5,0.5" Visibility="Collapsed">
                    <Border.RenderTransform><RotateTransform Angle="-7"/></Border.RenderTransform>
                    <TextBlock x:Name="StampText" Text="VERIFIED" FontFamily="{StaticResource DisplayBold}" FontSize="22"
                               Foreground="{StaticResource Green}"/>
                  </Border>
                  <TextBlock x:Name="Busy" Text="CHECKING" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,6,0"
                             FontFamily="{StaticResource Caps}" FontSize="13" Foreground="{StaticResource Gold}" Visibility="Collapsed"/>
                </Grid>
                <TextBlock x:Name="GamePathText" Foreground="{StaticResource Dim}" FontSize="12" Margin="0,10,0,0"
                           TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="4,16,0,0">
                  <Button Content="CHOOSE DISC IMAGE" Style="{StaticResource SlantButton}" Click="BrowseIso_Click"/>
                  <Button Content="USE A FOLDER" Style="{StaticResource SlantButton}" Margin="10,0,0,0" Click="BrowseFolder_Click"/>
                </StackPanel>

                <TextBlock Text="MATCH SETTINGS" Style="{StaticResource Label}" Margin="0,34,0,8"/>
                <Button Style="{StaticResource SheetRow}" Tag="graphics" Click="SheetRow_Click">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="01" Style="{StaticResource Num}"/>
                      <TextBlock Text="Resolution" Style="{StaticResource RowName}"/>
                    </StackPanel>
                    <TextBlock x:Name="SumRes" HorizontalAlignment="Right" FontFamily="{StaticResource Caps}" FontSize="15"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SheetRow}" Tag="display" Click="SheetRow_Click">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="02" Style="{StaticResource Num}"/>
                      <TextBlock Text="Display" Style="{StaticResource RowName}"/>
                    </StackPanel>
                    <TextBlock x:Name="SumDisplay" HorizontalAlignment="Right" FontFamily="{StaticResource Caps}" FontSize="15"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SheetRow}" Tag="controls" Click="SheetRow_Click">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="03" Style="{StaticResource Num}"/>
                      <TextBlock Text="Controls" Style="{StaticResource RowName}"/>
                    </StackPanel>
                    <TextBlock x:Name="SumCtl" HorizontalAlignment="Right" FontFamily="{StaticResource Caps}" FontSize="15"/>
                  </Grid>
                </Button>
                <Button Style="{StaticResource SheetRow}" Tag="display" Click="SheetRow_Click">
                  <Grid>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="04" Style="{StaticResource Num}"/>
                      <TextBlock Text="Frame rate" Style="{StaticResource RowName}"/>
                    </StackPanel>
                    <TextBlock x:Name="SumFps" HorizontalAlignment="Right" FontFamily="{StaticResource Caps}" FontSize="15"/>
                  </Grid>
                </Button>
                <Rectangle Height="1" Fill="{StaticResource Hair}"/>
              </StackPanel>

              <!-- DISPLAY -->
              <StackPanel x:Name="PageDisplay" Visibility="Collapsed">
                <TextBlock Text="SCREEN" Style="{StaticResource Label}"/>
                <TextBlock Text="Display" Style="{StaticResource Title}" Margin="0,4,0,18"/>
                <Border Style="{StaticResource Row}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Window mode" Style="{StaticResource RowName}"/>
                      <TextBlock Text="Borderless switches instantly." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                      <RadioButton x:Name="ModeWindow" Content="WINDOW" GroupName="mode" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                      <RadioButton x:Name="ModeBorderless" Content="BORDERLESS" GroupName="mode" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                      <RadioButton x:Name="ModeFullscreen" Content="FULLSCREEN" GroupName="mode" Style="{StaticResource Chip}" Checked="Setting_Changed" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Window size" Style="{StaticResource RowName}"/>
                      <TextBlock Text="Used in window mode." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <ComboBox x:Name="WindowBox" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="Setting_Changed"/>
                  </Grid>
                </Border>
                <Border Style="{StaticResource Row}">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="V-Sync" Style="{StaticResource RowName}"/>
                      <TextBlock Text="No tearing. Leave it on unless your display has its own sync." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <CheckBox x:Name="VSyncBox" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center" Margin="0,0,8,0"
                              Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                  </Grid>
                </Border>
                <Rectangle Height="1" Fill="{StaticResource Hair}"/>
              </StackPanel>

              <!-- GRAPHICS -->
              <StackPanel x:Name="PageGraphics" Visibility="Collapsed">
                <TextBlock Text="PICTURE" Style="{StaticResource Label}"/>
                <TextBlock Text="Graphics" Style="{StaticResource Title}" Margin="0,4,0,18"/>
                <TextBlock Text="Render resolution" Style="{StaticResource RowName}"/>
                <TextBlock Text="The game draws at this size and is scaled to your screen. Higher is sharper and asks more of the graphics card."
                           Style="{StaticResource Hint}" Margin="0,3,0,6"/>
                <StackPanel Orientation="Horizontal">
                  <RadioButton x:Name="Scale1" Content="720p" Tag="Original" GroupName="scale" Style="{StaticResource Score}" Checked="Setting_Changed"/>
                  <RadioButton x:Name="Scale2" Content="1440p" Tag="Sharp, recommended" GroupName="scale" Style="{StaticResource Score}" Checked="Setting_Changed"/>
                  <RadioButton x:Name="Scale3" Content="4K" Tag="Ultra, strong card" GroupName="scale" Style="{StaticResource Score}" Checked="Setting_Changed"/>
                </StackPanel>
                <Border Style="{StaticResource Row}" Margin="0,20,0,0">
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,16,0">
                      <TextBlock Text="Texture filtering" Style="{StaticResource RowName}"/>
                      <TextBlock Text="Keeps the pitch sharp toward the far touchline." Style="{StaticResource Hint}" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                      <RadioButton x:Name="AnisoOff" Content="OFF" GroupName="aniso" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                      <RadioButton x:Name="Aniso4" Content="4X" GroupName="aniso" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                      <RadioButton x:Name="Aniso8" Content="8X" GroupName="aniso" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                      <RadioButton x:Name="Aniso16" Content="16X" GroupName="aniso" Style="{StaticResource Chip}" Checked="Setting_Changed" Margin="0"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <Rectangle Height="1" Fill="{StaticResource Hair}"/>
                <TextBlock Style="{StaticResource Hint}" Margin="0,14,0,0">F3 in game shows the frame rate.</TextBlock>
              </StackPanel>

              <!-- CONTROLS -->
              <StackPanel x:Name="PageControls" Visibility="Collapsed">
                <TextBlock Text="INPUT" Style="{StaticResource Label}"/>
                <Grid Margin="0,4,0,16">
                  <TextBlock Text="Controls" Style="{StaticResource Title}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
                    <RadioButton x:Name="CtlPad" Content="CONTROLLER" GroupName="ctl" Style="{StaticResource Chip}" Checked="Setting_Changed"/>
                    <RadioButton x:Name="CtlKeys" Content="KEYBOARD" GroupName="ctl" Style="{StaticResource Chip}" Checked="Setting_Changed" Margin="0"/>
                  </StackPanel>
                </Grid>
                <TextBlock x:Name="CtlHint" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                  </Grid.ColumnDefinitions>
                  <StackPanel x:Name="KeyMapLeft" Margin="0,0,14,0"/>
                  <StackPanel x:Name="KeyMapRight" Grid.Column="1" Margin="14,0,0,0"/>
                </Grid>
              </StackPanel>

              <!-- ABOUT -->
              <StackPanel x:Name="PageAbout" Visibility="Collapsed">
                <TextBlock Text="THE PROJECT" Style="{StaticResource Label}"/>
                <TextBlock Text="About" Style="{StaticResource Title}" Margin="0,4,0,14"/>
                <TextBlock Style="{StaticResource Hint}" FontSize="13.5" Foreground="#C9C8BF" LineHeight="21">
                  An unofficial native PC port of the Xbox 360 game. Its code was translated to C++
                  with the ReXGlue recompiler, which builds on the Xenia project's research.
                  It runs from your own copy; no game files are included.
                </TextBlock>
                <TextBlock x:Name="AboutVersion" Style="{StaticResource Hint}" Margin="0,10,0,0"/>
                <WrapPanel Margin="4,22,0,0">
                  <Button Content="SAVES AND LOGS" Style="{StaticResource SlantButton}" Click="OpenDataFolder_Click" Margin="0,0,10,10"/>
                  <Button Content="DESKTOP SHORTCUT" Style="{StaticResource SlantButton}" Click="Shortcut_Click" Margin="0,0,10,10"/>
                  <Button Content="RESET SETTINGS" Style="{StaticResource SlantButton}" Click="Reset_Click" Margin="0,0,10,10"/>
                </WrapPanel>
                <TextBlock Style="{StaticResource Hint}" Margin="0,18,0,0" FontSize="11.5" Foreground="{StaticResource Dim}">
                  Fan project, not affiliated with or endorsed by EA, FIFA or Microsoft. Trademarks belong to their owners.
                </TextBlock>
              </StackPanel>
            </Grid>

            <!-- status + kick off -->
            <Grid Grid.Row="2" Margin="40,0,40,34">
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                  <Rectangle x:Name="ReadyDot" Width="10" Height="10" Fill="{StaticResource Dim}" VerticalAlignment="Center">
                    <Rectangle.RenderTransform><SkewTransform AngleX="-14"/></Rectangle.RenderTransform>
                  </Rectangle>
                  <TextBlock x:Name="ReadyText" Text="CHOOSE YOUR GAME" Margin="10,0,0,0" FontFamily="{StaticResource Caps}" FontSize="15"/>
                </StackPanel>
                <TextBlock x:Name="ToastText" Style="{StaticResource Hint}" Margin="20,3,0,0" FontSize="12"/>
              </StackPanel>
              <Button x:Name="PlayButton" Content="KICK OFF" Style="{StaticResource KickOff}" HorizontalAlignment="Right"
                      Click="Play_Click" IsEnabled="False" IsDefault="True"/>
            </Grid>
          </Grid>
        </Border>
      </Grid>

      <!-- drop target -->
      <Grid x:Name="DropOverlay" Background="#E6050607" Visibility="Collapsed" IsHitTestVisible="False">
        <Border BorderBrush="{StaticResource Gold}" BorderThickness="2" Margin="60" >
          <Border.RenderTransform><SkewTransform AngleX="-6"/></Border.RenderTransform>
        </Border>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
          <TextBlock Text="DROP YOUR DISC IMAGE" FontFamily="{StaticResource DisplayBold}" FontSize="54" HorizontalAlignment="Center"/>
          <TextBlock Text="Xbox 360 .iso, or the folder with default.xex" Style="{StaticResource Hint}" FontSize="14" HorizontalAlignment="Center"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Border>
</Window>
