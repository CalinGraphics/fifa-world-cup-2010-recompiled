<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Match night, broadcast 2010.
       Night sky and stands, floodlight white, trophy gold, pitch green, flag red. -->
  <Color x:Key="NightC">#06080B</Color>
  <Color x:Key="GoldC">#F2B632</Color>
  <Color x:Key="GreenC">#36A852</Color>
  <Color x:Key="RedC">#E2382B</Color>
  <SolidColorBrush x:Key="Night" Color="{StaticResource NightC}"/>
  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldC}"/>
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenC}"/>
  <SolidColorBrush x:Key="Red" Color="{StaticResource RedC}"/>
  <!-- legacy names used by code -->
  <SolidColorBrush x:Key="Good" Color="{StaticResource GreenC}"/>
  <SolidColorBrush x:Key="Bad" Color="{StaticResource RedC}"/>

  <SolidColorBrush x:Key="Panel" Color="#F70A0D0C"/>
  <SolidColorBrush x:Key="Hair" Color="#1FFFFFFF"/>
  <SolidColorBrush x:Key="HairStrong" Color="#38FFFFFF"/>
  <SolidColorBrush x:Key="Text" Color="#F3EFE6"/>
  <SolidColorBrush x:Key="Muted" Color="#9A9C94"/>
  <SolidColorBrush x:Key="Dim" Color="#62655F"/>
  <SolidColorBrush x:Key="Line" Color="#1FFFFFFF"/>

  <LinearGradientBrush x:Key="GoldMetal" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FBE08A" Offset="0"/>
    <GradientStop Color="#F2B632" Offset="0.45"/>
    <GradientStop Color="#B9801C" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="Display">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayBold">Bahnschrift Bold Condensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Caps">Bahnschrift SemiBold SemiConden, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Section label: small caps, wide tracking feel via condensed caps face -->
  <Style x:Key="Label" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
  </Style>
  <Style x:Key="Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="34"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="RowName" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="Num" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="15"/>
    <Setter Property="Foreground" Value="{StaticResource Dim}"/>
    <Setter Property="Width" Value="30"/>
  </Style>

  <!-- A settings row: hairline on top, generous height, no box -->
  <Style x:Key="Row" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource Hair}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0,16,0,16"/>
  </Style>

  <!-- Team-sheet row: a whole line is a button that opens its settings page -->
  <Style x:Key="SheetRow" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" BorderBrush="{StaticResource Hair}" BorderThickness="0,1,0,0" Background="Transparent" Padding="0,13,6,13">
            <Grid>
              <ContentPresenter HorizontalAlignment="Stretch"/>
              <Border x:Name="mark" Width="3" Background="{StaticResource Gold}" HorizontalAlignment="Left" Margin="-12,0,0,0" Opacity="0"/>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#0AFFFFFF"/>
              <Setter TargetName="mark" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Text button with a slanted outline (Change disc, folder...) -->
  <Style x:Key="SlantButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="b" BorderBrush="{StaticResource HairStrong}" BorderThickness="1" Background="#0DFFFFFF">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="18,8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter TargetName="b" Property="Background" Value="#1AF2B632"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.7"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Foreground" Value="#B8B9B2"/>
    <Setter Property="Width" Value="44"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#26FFFFFF"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- KICK OFF: slanted gold bar, like a broadcast score bug -->
  <Style x:Key="KickOff" TargetType="Button">
    <Setter Property="Foreground" Value="#17110A"/>
    <Setter Property="FontFamily" Value="{StaticResource DisplayBold}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid x:Name="g" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform><TranslateTransform x:Name="shift"/></Grid.RenderTransform>
            <Border x:Name="b" Background="{StaticResource GoldMetal}">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
            <Border x:Name="edge" Background="#17110A" Width="6" HorizontalAlignment="Left" Margin="10,0,0,0">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="40,9,46,7" VerticalAlignment="Center">
              <ContentPresenter VerticalAlignment="Center"/>
              <Path x:Name="arrow" Data="M0,0 L10,9 L0,18" Stroke="#17110A" StrokeThickness="3.2" Width="10" Height="18"
                    Stretch="Fill" VerticalAlignment="Center" Margin="16,0,0,2" StrokeEndLineCap="Square" StrokeStartLineCap="Square"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="4" Duration="0:0:0.14">
                      <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.EnterActions>
              <Trigger.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="shift" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"/>
                  </Storyboard>
                </BeginStoryboard>
              </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="#2A2C29"/>
              <Setter TargetName="edge" Property="Background" Value="#3C3E3A"/>
              <Setter TargetName="arrow" Property="Stroke" Value="#5E605B"/>
              <Setter Property="Foreground" Value="#5E605B"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Top navigation: plain caps, active one gets a gold slanted underline -->
  <Style x:Key="NavTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#8E9089"/>
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,28,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <ContentPresenter Margin="0,10,0,12"/>
            <Border x:Name="bar" Height="3" VerticalAlignment="Bottom" Background="{StaticResource Gold}" Opacity="0">
              <Border.RenderTransform><SkewTransform AngleX="-30"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="bar" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Choice chips: flat, slanted; checked = gold fill -->
  <Style x:Key="Chip" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="b" BorderBrush="{StaticResource HairStrong}" BorderThickness="1" Background="Transparent">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
            <ContentPresenter Margin="16,7,16,7" HorizontalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="#80F2B632"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Gold}"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter Property="Foreground" Value="#17110A"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Scoreboard choice: a big number with a caption; checked = gold number + bar -->
  <Style x:Key="Score" TargetType="RadioButton">
    <Setter Property="Foreground" Value="#6E716B"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Margin="0,0,26,0">
            <StackPanel>
              <ContentPresenter x:Name="num" TextElement.FontFamily="{StaticResource DisplayBold}" TextElement.FontSize="54"/>
              <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource Body}" FontSize="12" Foreground="{StaticResource Dim}" Margin="2,-4,0,10"/>
              <Border x:Name="bar" Height="3" Background="{StaticResource Gold}" Opacity="0"/>
            </StackPanel>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#B9BAB3"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Gold}"/>
              <Setter TargetName="bar" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="track" Width="46" Height="22" BorderBrush="{StaticResource HairStrong}" BorderThickness="1" Background="Transparent">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
            <Border x:Name="knob" Width="18" Height="14" Background="#8E9089" HorizontalAlignment="Left" Margin="5,0,0,0">
              <Border.RenderTransform><SkewTransform AngleX="-14"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter TargetName="knob" Property="Background" Value="{StaticResource Gold}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,5,0"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ComboBox, square and quiet -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="#0DFFFFFF" BorderBrush="{StaticResource HairStrong}" BorderThickness="1">
            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Gold}" StrokeThickness="1.6" Width="10" Height="5"
                  HorizontalAlignment="Right" Margin="0,0,14,0" Stretch="Fill"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="13.5"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="Transparent" Padding="14,8">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#1FF2B632"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Caps}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="230"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                              VerticalAlignment="Center" Margin="14,0,34,0"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
              <Border Background="#F2101412" BorderBrush="{StaticResource HairStrong}" BorderThickness="1"
                      Margin="0,3,0,0" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#101412"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource HairStrong}"/>
  </Style>
</ResourceDictionary>
