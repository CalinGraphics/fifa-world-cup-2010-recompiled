<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- South Africa 2010 palette: flag colours on a night-stadium base -->
  <Color x:Key="GreenC">#00A86B</Color>
  <Color x:Key="GoldC">#FFB612</Color>
  <Color x:Key="RedC">#E03C31</Color>
  <Color x:Key="BlueC">#1F4FD8</Color>
  <SolidColorBrush x:Key="Green" Color="{StaticResource GreenC}"/>
  <SolidColorBrush x:Key="Gold" Color="{StaticResource GoldC}"/>
  <SolidColorBrush x:Key="Red" Color="{StaticResource RedC}"/>
  <SolidColorBrush x:Key="Blue" Color="{StaticResource BlueC}"/>

  <SolidColorBrush x:Key="Bg" Color="#0C1310"/>
  <SolidColorBrush x:Key="Surface" Color="#121C17"/>
  <SolidColorBrush x:Key="Card" Color="#17241E"/>
  <SolidColorBrush x:Key="CardHover" Color="#1D2D25"/>
  <SolidColorBrush x:Key="Line" Color="#26382F"/>
  <SolidColorBrush x:Key="Text" Color="#F4F1E8"/>
  <SolidColorBrush x:Key="Muted" Color="#93A89C"/>
  <SolidColorBrush x:Key="Dim" Color="#5F7468"/>
  <SolidColorBrush x:Key="Good" Color="#3DDC97"/>
  <SolidColorBrush x:Key="Bad" Color="#FF6B5E"/>

  <LinearGradientBrush x:Key="GoldGradient" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFD25A" Offset="0"/>
    <GradientStop Color="#FFB612" Offset="0.55"/>
    <GradientStop Color="#F08A0C" Offset="1"/>
  </LinearGradientBrush>

  <FontFamily x:Key="Display">Bahnschrift SemiBold Condensed, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayWide">Bahnschrift SemiBold, Bahnschrift, Segoe UI</FontFamily>
  <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

  <!-- Text -->
  <Style x:Key="H1" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="30"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="Overline" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayWide}"/>
    <Setter Property="FontSize" Value="11.5"/>
    <Setter Property="Foreground" Value="{StaticResource Gold}"/>
  </Style>
  <Style x:Key="CardTitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource DisplayWide}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- Card container -->
  <Style x:Key="CardBorder" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource Card}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="12"/>
    <Setter Property="Padding" Value="20,16"/>
  </Style>

  <!-- Plain button -->
  <Style x:Key="GhostButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Background" Value="#22342B"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Padding" Value="16,8"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#2C4337"/>
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.8"/></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Window caption buttons -->
  <Style x:Key="CaptionButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="Width" Value="40"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="10"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="#22342B"/>
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="b" Background="Transparent" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Red}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Big PLAY button -->
  <Style x:Key="PlayButton" TargetType="Button">
    <Setter Property="Foreground" Value="#1A1205"/>
    <Setter Property="FontFamily" Value="{StaticResource Display}"/>
    <Setter Property="FontSize" Value="26"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="glow" CornerRadius="14" Background="{StaticResource GoldGradient}" Opacity="0.45">
              <Border.Effect><BlurEffect Radius="22"/></Border.Effect>
            </Border>
            <Border x:Name="b" CornerRadius="14" Background="{StaticResource GoldGradient}" Padding="44,12">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Path Data="M0,0 L14,8 L0,16 Z" Fill="#1A1205" Width="14" Height="16" Stretch="Fill"
                      VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ContentPresenter VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="glow" Property="Opacity" Value="0.8"/>
              <Setter TargetName="b" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="1.02" ScaleY="1.02"/></Setter.Value></Setter>
              <Setter TargetName="b" Property="RenderTransformOrigin" Value="0.5,0.5"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="b" Property="Background" Value="#2A3A31"/>
              <Setter TargetName="glow" Property="Opacity" Value="0"/>
              <Setter Property="Foreground" Value="#5F7468"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Top navigation tabs (RadioButtons) -->
  <Style x:Key="NavTab" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontFamily" Value="{StaticResource DisplayWide}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,26,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <ContentPresenter Margin="0,8,0,10"/>
            <Border x:Name="bar" Height="3" CornerRadius="2" VerticalAlignment="Bottom" Background="{StaticResource Gold}" Opacity="0"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Text}"/>
              <Setter TargetName="bar" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Segmented choice (RadioButtons in a row) -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="MinWidth" Value="96"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="Transparent" CornerRadius="7" Padding="14,7" Margin="2">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Text}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="Background" Value="{StaticResource Gold}"/>
              <Setter Property="Foreground" Value="#1A1205"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SegmentHost" TargetType="Border">
    <Setter Property="Background" Value="#0F1814"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="Padding" Value="2"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>

  <!-- Big option card (RadioButton): Content = title, Tag = description -->
  <Style x:Key="OptionCard" TargetType="RadioButton">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource Line}" BorderThickness="1.5"
                  CornerRadius="12" Padding="18,14">
            <Grid>
              <StackPanel>
                <ContentPresenter TextElement.FontFamily="{StaticResource Display}" TextElement.FontSize="24"/>
                <TextBlock Text="{TemplateBinding Tag}" Style="{StaticResource Hint}" Margin="0,4,0,0"/>
              </StackPanel>
              <Border x:Name="tick" Width="20" Height="20" CornerRadius="10" Background="{StaticResource Gold}"
                      HorizontalAlignment="Right" VerticalAlignment="Top" Opacity="0">
                <Path Data="M0,4 L3.5,7.5 L10,0" Stroke="#1A1205" StrokeThickness="2" Width="10" Height="8" Stretch="Fill"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              <Setter TargetName="tick" Property="Opacity" Value="1"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Toggle switch (CheckBox) -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Border x:Name="track" Width="44" Height="24" CornerRadius="12" Background="#2A3A31">
            <Ellipse x:Name="knob" Width="18" Height="18" Fill="#C9D3CD" HorizontalAlignment="Left" Margin="3,0,0,0"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="track" Property="Background" Value="{StaticResource Green}"/>
              <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
              <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
              <Setter TargetName="knob" Property="Fill" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Dark ComboBox -->
  <Style x:Key="ComboToggle" TargetType="ToggleButton">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="b" Background="#0F1814" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8">
            <Path Data="M0,0 L5,5 L10,0" Stroke="{StaticResource Muted}" StrokeThickness="1.6" Width="10" Height="5"
                  HorizontalAlignment="Right" Margin="0,0,14,0" Stretch="Fill"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="Padding" Value="12,8"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="b" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="4,1">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="b" Property="Background" Value="#22342B"/></Trigger>
            <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="FontFamily" Value="{StaticResource Body}"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="MinWidth" Value="220"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton Style="{StaticResource ComboToggle}" Focusable="False"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"/>
            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" IsHitTestVisible="False"
                              VerticalAlignment="Center" Margin="14,0,34,0"/>
            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True"
                   Focusable="False" PopupAnimation="Fade">
              <Border Background="#16231D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="8"
                      Margin="0,4,0,0" Padding="0,4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="280" VerticalScrollBarVisibility="Auto">
                  <ItemsPresenter/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Link-style button -->
  <Style x:Key="LinkButton" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource Muted}"/>
    <Setter Property="FontSize" Value="12.5"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <ContentPresenter/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="{StaticResource Gold}"/></Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="Background" Value="#16231D"/>
    <Setter Property="Foreground" Value="{StaticResource Text}"/>
    <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
  </Style>
</ResourceDictionary>
