+REXCVAR_DEFINE_INT32(frame_rate_limit, 0, "GPU",
+                     "Most frames per second the guest may present (0: no limit, the game's own "
+                     "pacing). The guest waits in VdSwap when it presents sooner.")
+    .range(0, 240);
+
 namespace {
+std::atomic<uint64_t> vd_swap_count{0};
+
+// Holds the presenting guest thread so frames are at least 1/frame_rate_limit apart.
+// Keeps the cadence from frame to frame; after a stall (loading) it starts over.
+void LimitFrameRate() {
+  int32_t limit = REXCVAR_GET(frame_rate_limit);
+  if (limit <= 0) {
+    return;
+  }
+  using clock = std::chrono::steady_clock;
+  static clock::time_point last{};
+  const auto period = std::chrono::nanoseconds(1000000000LL / limit);
+  auto now = clock::now();
+  if (last == clock::time_point{} || now - last > period * 4) {
+    last = now;
+    return;
+  }
+  auto target = last + period;
+  if (now < target) {
+    // Sleep most of the way, then yield-spin: Sleep alone overshoots by up to a timer tick.
+    auto coarse = target - std::chrono::microseconds(1500);
+    if (now < coarse) {
+      std::this_thread::sleep_until(coarse);
+    }
+    while (clock::now() < target) {
+      std::this_thread::yield();
+    }
+    last = target;
+  } else {
+    last = (now - target > period) ? now : target;
+  }
+}
